/.idea/

# Ignore all dot-directories (e.g. .idea, .vscode, .venv)
.*/

# IntelliJ module files
*.iml

# Python
__pycache__/
*.py[cod]

# Throwaway recon scripts (findings recorded in docs/schema-notes.md)
_inspect*.py

# Local docs (contain machine-specific paths / recon notes)
docs/

# But keep the Claude Code plugin manifest (it's a required tracked file)
!.claude-plugin/
!.claude-plugin/**

